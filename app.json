{
  "expo": {
    "name": "tuporderup",
    "slug": "tuporderup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tuporderup",                               
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.vaynix2.tuporderup",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#A6192E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vaynix2.tuporderup"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7D1021",
          "image": "./assets/main-image/logo.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],

      "@react-native-community/datetimepicker",

      "expo-secure-store",

      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow TUPC-OrderUp to use Face ID to securely sign you in."
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "71ba836c-d2cc-4f2a-a8f4-8db0e45a0da9"
      }
    },

    "owner": "v_aynix2"
  }
}